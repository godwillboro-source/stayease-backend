# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-secret
# In Render, set DATABASE_URL to your Render Postgres internal URL.
# Locally, leave it unset to use the project's SQLite database.

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rental.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="StayEase <onboarding@your-verified-domain.com>"
